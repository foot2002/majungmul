[Unit]
Description=Majungmul development validation
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/majungmul/dev/current
EnvironmentFile=/etc/majungmul/.env_dev
ExecStart=/usr/bin/env NODE_ENV=production APP_ENV=dev HOST=127.0.0.1 PORT=3001 /usr/bin/node /srv/majungmul/dev/current/server/index.mjs
Restart=always
RestartSec=3
TimeoutStopSec=35
MemoryHigh=256M
MemoryMax=384M
CPUQuota=50%
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0027

[Install]
WantedBy=multi-user.target
